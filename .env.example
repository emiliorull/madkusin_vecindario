# ============================================================================
# MADKUSIN VECINDARIO (CP 28224) - VARIABLES DE ENTORNO
# Subdominio objetivo: https://vecindario.madkusin.com
# ============================================================================

# ----------------------------------------------------------------------------
# 1. VARIABLES PÚBLICAS DE FRONTEND (Expuestas en el cliente con prefijo VITE_)
# Configúralas también en Cloudflare Pages -> Settings -> Environment Variables
# ----------------------------------------------------------------------------

# Endpoint GET de n8n para consultar huecos disponibles en Google Calendar (L-V 10:00 a 13:00)
# Si se deja vacío durante el desarrollo, la web activará automáticamente el modo Mock/Fallback inteligente.
VITE_N8N_WEBHOOK_DISPONIBILIDAD=https://n8n.madkusin.com/webhook/vecindario-disponibilidad

# Endpoint POST de n8n para confirmar reserva (crea evento GCal, guarda en PocketBase y envía email .ics)
VITE_N8N_WEBHOOK_RESERVAR=https://n8n.madkusin.com/webhook/vecindario-reservar

# Usuario del Bot de Telegram (sin @) para generar el deeplink post-reserva:
# https://t.me/madkusin_citas_bot?start=cita_ID
VITE_TELEGRAM_BOT_USERNAME=madkusin_citas_bot

# Proveedor de voz preferido en el cliente ("gemini" | "elevenlabs" | "hybrid")
VITE_VOICE_PROVIDER=gemini

# ----------------------------------------------------------------------------
# 2. VARIABLES PRIVADAS SERVERLESS (Cloudflare Pages Functions: /functions/api/voice-config.js)
# IMPORTANTE: NO llevan prefijo VITE_ para no filtrarse nunca en el bundle JS del navegador.
# Configúralas como Secretos en Cloudflare Pages Dashboard.
# ----------------------------------------------------------------------------

# Clave de API de Google AI Studio para Gemini Multimodal Live API
GEMINI_API_KEY=tu_clave_privada_gemini_aqui

# Modelo de Gemini Multimodal Live (por defecto: gemini-2.0-flash-exp)
GEMINI_LIVE_MODEL=models/gemini-2.0-flash-exp

# Voz de Gemini Live ("Puck", "Charon", "Kore", "Fenrir", "Aoede")
GEMINI_VOICE_NAME=Aoede

# (Opcional - Futuro) Credenciales para alternar el motor a ElevenLabs Conversational AI
VOICE_PROVIDER=gemini
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
